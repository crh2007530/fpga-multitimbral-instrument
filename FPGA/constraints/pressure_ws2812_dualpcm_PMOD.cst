// New optical pluck: Console32001C J10.9 / SDRAM1_D15 / W17, 3.3V only.
IO_LOC "pluck_ir" W17;
IO_PORT "pluck_ir" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Merged pressure/WS2812B/dual PCM5102. GW5AT-60B PBGA484A only.
IO_LOC "clk_50m" V22;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc0_scl" F19;
IO_LOC "adc0_sda" F20;
IO_LOC "adc1_scl" G21;
IO_LOC "adc1_sda" G22;
IO_PORT "adc0_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "adc0_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "adc1_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "adc1_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "i2s_bclk" E22;
IO_LOC "i2s_lrclk" D22;
IO_LOC "i2s_din" E21;
IO_LOC "xsmt" D21;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "xsmt" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "debug_tx" U15;
IO_PORT "debug_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "status_led" W20; // J7.12 / PMOD1_IO1, optional active-low LED
IO_PORT "status_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

// Console PMODs. Original ADC + PCM1 pins stay unchanged.
IO_LOC "pcm2_bclk" F18; // J6.7 / PMOD0_IO4
IO_LOC "pcm2_lrclk" E18; // J6.8 / PMOD0_IO5
IO_LOC "pcm2_din" C22; // J6.5 / PMOD0_IO6
IO_LOC "pcm2_xsmt" B22; // J6.6 / PMOD0_IO7, optional PCM2 mute enable
IO_LOC "oled_scl" V18; // J6.11 / PMOD0_IO0, optional open-drain OLED
IO_LOC "oled_sda" V19; // J6.12 / PMOD0_IO1, optional open-drain OLED
IO_LOC "dout" W19; // J7.11 / PMOD1_IO0, WS2812B DIN via level shifter if needed
IO_PORT "pcm2_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "pcm2_lrclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "pcm2_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "pcm2_xsmt" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "oled_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "oled_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// J6/J7 pins 1,2=3.3 V, pins 3,4=GND. TTP229 additionally uses J10.1/2.

// TTP229: J10.1 SDRAM1_D0 / R19, J10.2 SDRAM1_D1 / P19 (schematic pp4,8).
IO_LOC "ttp_scl" R19;
IO_LOC "ttp_sdo" P19;
IO_PORT "ttp_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "ttp_sdo" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Console 32001C schematic pp4,8: J10.3=SDRAM1_D2/U21; J10.4=SDRAM1_D3/T21.
// TTP stays on J10.1/R19 and J10.2/P19. Independent APDS bus.
IO_LOC "apds_scl" U21;
IO_LOC "apds_sda" T21;
IO_PORT "apds_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_PORT "apds_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;

// Console 32001C schematic p4/p8: SDRAM1_D4=R17 (J10.5), D5=P16 (J10.6).
// Dedicated JDY-31 UART. No SDRAM module/cartridge may share these pins.
IO_LOC "bt_rx" R17;
IO_LOC "bt_tx" P16;
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;

// Console32001C p5 SOM_BTB1 actual GW5AT60 ball labels; p9 notes reference another package.
IO_LOC "hdmi_data_p[0]" J14,H14;
IO_LOC "hdmi_data_p[1]" J15,H15;
IO_LOC "hdmi_data_p[2]" K17,J17;
IO_LOC "hdmi_clk_p" G15,G16;
IO_PORT "hdmi_data_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "hdmi_data_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "hdmi_data_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_PORT "hdmi_clk_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;

IO_LOC "hdmi_power" K14;
IO_PORT "hdmi_power" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;

// Rotary A/B only. C is module GND, NOT a push switch. Module supply 3.3V.
// No SDRAM/cartridge allowed on these J10 pins.
IO_LOC "encoder_a" T18; // J10.7 SDRAM1_D6
IO_LOC "encoder_b" R18; // J10.8 SDRAM1_D7
IO_PORT "encoder_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "encoder_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// V21: Console32001C schematic p6,p8; free J10 SDRAM1 pins, 3.3V.
IO_LOC "volume_a" W22; // J10.13 SDRAM1_D13
IO_LOC "volume_b" W21; // J10.14 SDRAM1_D12
IO_LOC "game_button_n" P17; // J10.15 SDRAM1_D11, NO contact to GND
IO_PORT "volume_a" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "volume_b" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "game_button_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Second NO button: J10.16 -> SDRAM1_D10 -> N17, schematic pp6,8.
IO_LOC "fx_button_n" N17;
IO_PORT "fx_button_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
